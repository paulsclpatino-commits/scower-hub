# Copy this file to .env and fill in the keys you have. Every key is optional:
# Scower uses whichever sources are configured and skips the rest.

# --- AI item identification (recommended) ----------------------------------
# Works out exactly what's in the photo (brand, model, colorway) and checks
# which listings are really that item. https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Google Lens + Google Shopping, via SerpApi (recommended) --------------
# Reverse-image search across the web: Grailed, StockX, Depop, Poshmark,
# Mercari, GOAT, brand stores and more. https://serpapi.com (free tier available)
# Each photo search uses 3 SerpApi searches (2 Lens + 1 Shopping).
SERPAPI_KEY=

# --- eBay ---------------------------------------------------------------------
# Free developer account: https://developer.ebay.com -> Application Keys ->
# create a Production keyset and copy the App ID (Client ID) and Cert ID (Client Secret).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# EBAY_MARKETPLACE=EBAY_US

# --- Optional settings ----------------------------------------------------------
# PORT=3000

# Google Lens has to download your photo from a public URL. When the site runs
# on a public host (Render, Railway, Fly...) this is detected automatically.
# Set it explicitly if detection gets it wrong:
# PUBLIC_URL=https://your-site.example.com

# When running on localhost, photos are uploaded to litterbox.catbox.moe
# (deleted automatically after 1 hour) so Google Lens can see them.
# Set to "off" to never upload photos anywhere; Lens is then skipped for uploads.
# TEMP_IMAGE_HOST=litterbox

# Country for Google results and prices (two-letter code).
# SEARCH_COUNTRY=us

# Max searches per visitor IP per 10 minutes.
# SEARCH_RATE_LIMIT=30

# Number of reverse proxies in front of the app (for correct client IPs).
# TRUST_PROXY=1

# Claude model used for identification and match checking.
# ANTHROPIC_MODEL=claude-opus-5-5
